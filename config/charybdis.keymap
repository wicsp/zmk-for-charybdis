#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <150>;
    flavor = "hold-preferred";
    quick-tap-ms = <0>;
    // Press Ctrl immediately; release it before sending a standalone Esc tap.
    hold-while-undecided;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp GRAVE                &kp N1  &kp N2  &kp N3        &kp N4        &kp N5    &kp N6            &kp N7       &kp N8     &kp N9   &kp N0         &kp ESCAPE
&kp TAB                  &kp Q   &kp W   &kp F         &kp P         &kp B     &kp J             &kp L        &kp U      &kp Y    &kp SEMICOLON  &kp MINUS
&mt LEFT_CONTROL ESCAPE  &kp A   &kp R   &kp S         &kp T         &kp G     &kp M             &kp N        &kp E      &kp I    &kp O          &kp SQT
&kp LEFT_SHIFT           &kp Z   &kp X   &kp C         &kp D         &kp V     &kp K             &kp H        &kp COMMA  &kp DOT  &kp FSLH       &kp RIGHT_SHIFT
                                         &kp LEFT_WIN  &lt 1 SPACE   &kp F20   &kp RG(LEFT_ALT)  &lt 1 ENTER
                                                       &kp LEFT_ALT  &mo 2     &kp F19
            >;
        };

        F_layers {
            bindings = <
&kp F1     &kp F2  &kp F3  &kp F4  &kp F5  &kp F6        &kp F7     &kp F8     &kp F9            &kp F10            &kp F11        &kp F12
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5        &kp N6     &kp N7     &kp N8            &kp N9             &kp N0         &kp EQUAL
&trans     &none   &none   &none   &none   &trans        &kp LEFT   &kp DOWN   &kp UP_ARROW      &kp RIGHT          &kp BACKSPACE  &kp DELETE
&trans     &trans  &trans  &trans  &trans  &none         &mkp RCLK  &mkp LCLK  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH  &trans
                           &trans  &trans  &trans         &trans     &kp ENTER
                                   &trans  &trans        &trans
            >;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans      &trans
                                                    &trans        &trans          &trans
            >;
        };

    };
};
